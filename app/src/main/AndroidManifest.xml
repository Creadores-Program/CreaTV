<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1" android:versionName="1.0.0-beta" android:installLocation="auto">
    <uses-sdk android:minSdkVersion="16" android:targetSdkVersion="29" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:name=".CreaTvApp" android:icon="@drawable/ic_launcher" android:label="@string/app_name" android:theme="@style/AppTheme">
        <activity android:name=".MainActivity"
            android:label="@string/app_name" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".StreamActivity"
            android:label="@string/app_name" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" android:theme="@style/Theme.TransparentActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="twitch.tv" />
                <data android:host="m.twitch.tv" />
                <data android:host="go.twitch.tv" />
                <data android:host="www.twitch.tv" />
                <data android:pathPattern="/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="kick.com" />
                <data android:host="www.kick.com" />
                <data android:pathPattern="/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="youtu.be" />
                <data android:host="m.youtube.com" />
                <data android:pathPrefix="/live/" />
                <data android:pathPattern="/@.*/live" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="vt.tiktok.com" />
                <data android:host="vm.tiktok.com" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="www.tiktok.com" />
                <data android:host="tiktok.com" />
                <data android:pathPattern="/@.*/live" />
            </intent-filter>
        </activity>
        <activity android:name=".ChatActivity"
            android:label="@string/app_name" android:exported="false" android:theme="@style/Theme.TransparentActivity" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />
    </application>
</manifest>
